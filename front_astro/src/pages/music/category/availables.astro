---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { client, type Categories } from '@/stores/music' 

let availableCategories: Categories = []

const res = await client.category.$get()
if (res.ok) {
  availableCategories = await res.json()
}
---

<PublicLayout>
  <section class="flex">
    {
      availableCategories.map((category) => (
        <article
          class="px-5"
        >
          <a href={`/music/category/${category.categoryId}`}>
            <header>{ category.name }</header>
            <section>
              <p>{ category.description }</p>
            </section>
          </a>
        </article>
      ))
    }
  </section>
</PublicLayout>