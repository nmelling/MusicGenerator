---
import { hc, type InferResponseType } from 'hono/client'
import type { MusicRoutes } from '@/../../back/src/modules/music/music'
import CategoryForm from '@/components/music/CategoryForm.vue'
import { client, type CategoryResponse } from '@/stores/music'

interface Props {
  categoryId: number
}

const { categoryId } = Astro.props;

let category: CategoryResponse | undefined

const res = await client.category.specific.$get({
  query: {
    categoryId: String(categoryId),
  },
})

if (res.ok) {
  category = await res.json()
}
---

{
  category ? (
    <article>
      <header>
        <h3>{ category.name}</h3>
      </header>
      <section>
        <CategoryForm
          questions={ category.questions }
          categoryId={category.categoryId}
        />
      </section>
    </article>
  ) : (
    <p>Aucune catégorie</p> <!--TODO enhance -->
  )
}
